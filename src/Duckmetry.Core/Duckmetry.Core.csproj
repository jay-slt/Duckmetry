<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.5" />
  </ItemGroup>

  <!-- Lets the test project use the internal test seams (e.g. the settings-path override
       that keeps the settings tests off the user's real settings file). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Duckmetry.Tests" />
  </ItemGroup>

</Project>
