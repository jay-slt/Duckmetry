<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A read-only diagnostic. Not part of the shipped converter.

    It enumerates every file-mapping object on the machine, prints what it finds, and
    tries to interpret the plausible ones using the LMU_Extended layout. It writes
    nothing, opens nothing for writing, and cannot affect the game.

    See README.md in this folder for how to run it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DuckmetryProbe</AssemblyName>
    <Product>DuckmetryProbe - diagnostic for Duckmetry</Product>
    <Company>Independent community project</Company>
    <Copyright>Copyright (c) 2026 jay-slt. Not affiliated with MoTeC Ltd or Studio 397.</Copyright>
    <Description>Read-only diagnostic tool for the Duckmetry converter. Independent tool; not endorsed by MoTeC Ltd or Studio 397.</Description>
    <RootNamespace>DuckmetryProbe</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!--
      IncludeNativeLibrariesForSelfExtract is required for the same reason as the app: a
      single-file publish leaves native libraries beside the exe unless told otherwise, and
      the released v2.16.1 probe shipped as an exe alone. This tool has no native dependency
      of its own, but the setting is kept so the two publish identically.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>